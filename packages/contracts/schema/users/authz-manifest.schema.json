{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bizcity.vn/schema/users/authz-manifest.schema.json",
  "title": "bizcity_authz_manifest@1 — bizcity.authz.json: quyền, vai, phạm vi khoá API, user meta, cài đặt của một app",
  "$comment": "[2026-11-25 10:34 AM Johnny Chu - Chu Hoàng Anh] USERS-1 — khuôn chung người dùng · vai · phân quyền (BIZCITY-USERS-ROLES-v1.md §3). Sinh bằng authzManifest() của @bizcity/platform; plugin WordPress viết tay. Luật chéo (vai trỏ quyền có thật, phạm vi khoá không có quyền rủi ro cao…) ở tools/users-check.mjs.",
  "type": "object",
  "required": ["schema", "app", "permissions", "roles"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "bizcity_authz_manifest@1" },
    "app": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,40}$" },
    "core_permissions": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/permissionKey" } },
    "permissions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["key", "label", "risk"],
        "additionalProperties": false,
        "properties": {
          "key": { "$ref": "#/$defs/permissionKey" },
          "label": { "type": "string", "minLength": 1, "maxLength": 160 },
          "risk": { "enum": ["low", "high"] },
          "module": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" }
        }
      }
    },
    "roles": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["key", "label", "permissions"],
        "additionalProperties": false,
        "properties": {
          "key": { "type": "string", "pattern": "^[a-z][a-z0-9_]{1,39}$" },
          "label": { "type": "string", "minLength": 1, "maxLength": 120 },
          "admin": { "type": "boolean" },
          "permissions": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/permissionKey" } }
        }
      }
    },
    "api_scopes": {
      "type": "object",
      "additionalProperties": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/permissionKey" } }
    },
    "user_meta": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["key", "label", "type"],
        "additionalProperties": false,
        "properties": {
          "key": { "type": "string", "pattern": "^(bizcity\\.)?[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$" },
          "label": { "type": "string", "minLength": 1 },
          "type": { "enum": ["string", "text", "int", "bool", "date", "enum", "string[]", "json"] },
          "pii": { "type": "boolean" }
        }
      }
    },
    "settings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["key", "label", "scopes", "permission"],
        "additionalProperties": false,
        "properties": {
          "key": { "type": "string", "pattern": "^bizcity\\.[a-z0-9_]+(\\.[a-z0-9_]+)+$" },
          "label": { "type": "string", "minLength": 1 },
          "scopes": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["tenant", "accounting_unit", "branch", "user"] } },
          "permission": { "$ref": "#/$defs/permissionKey" }
        }
      }
    }
  },
  "$defs": {
    "permissionKey": { "type": "string", "pattern": "^[a-z][a-z0-9-]*:[a-z][a-z0-9-]*$" }
  }
}
