{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bizcity.vn/schema/failure-map/failure-map.schema.json",
  "$comment": "[2026-11-25 05:18 PM Johnny Chu - Chu Hoàng Anh] STD-10 — bizcity_failure_map@1 (BIZCITY-FAILURE-MAP-v1.md): bản đồ lỗi theo màn — mỗi thao tác của màn hỏng vì đâu, chỉ vào đâu, bắt ở tầng nào, test nào khoá. · [2026-11-25 06:12 PM Johnny Chu - Chu Hoàng Anh] STD-11 — thêm screen.entities (đối tượng API màn ghi vào, để nối nhật ký từ chối) và questions (câu hỏi ngược đã trả lời, bizcity_feedback_loop@1)",
  "title": "bizcity_failure_map@1",
  "type": "object",
  "required": [
    "schema",
    "screen",
    "actions",
    "rows"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "bizcity_failure_map@1"
    },
    "screen": {
      "type": "object",
      "required": [
        "code",
        "label",
        "file"
      ],
      "additionalProperties": false,
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9]{1,9}$",
          "$comment": "mã màn của repo (vd ACC14, MH05)"
        },
        "label": {
          "type": "string",
          "minLength": 2
        },
        "file": {
          "type": "string",
          "minLength": 3,
          "$comment": "tệp form / màn, tính từ gốc repo"
        },
        "route": {
          "type": "string"
        },
        "entities": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "$comment": "đối tượng API màn ghi vào, khớp entity trong nhật ký từ chối (vd mua-hang/phieu-mua)"
        }
      }
    },
    "actions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/action"
      }
    },
    "codeSources": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 3
      },
      "$comment": "tệp danh mục mã của repo (vd packages/contracts/src/errors.ts); bỏ trống = dò cả repo"
    },
    "rows": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/row"
      }
    },
    "questions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "answer"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^Q-[A-Z]+-[0-9]{2}$"
          },
          "ask": {
            "type": "string"
          },
          "answer": {
            "type": [
              "string",
              "null"
            ],
            "$comment": "null = chưa trả lời; hỏi người yêu cầu, không đoán (R-STD-LOOP-2)"
          },
          "rows": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "$comment": "dòng bản đồ sinh từ câu trả lời"
          }
        }
      }
    }
  },
  "$defs": {
    "action": {
      "type": "string",
      "pattern": "^(them|sua|xoa|luu-nhap|ghi-so|duyet|bo-duyet|huy|nhap-file|gui|x-[a-z][a-z0-9-]*)$"
    },
    "row": {
      "type": "object",
      "required": [
        "id",
        "action",
        "code",
        "level",
        "when",
        "target",
        "catchAt",
        "hint"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9]*-[0-9]{2,3}$"
        },
        "action": {
          "$ref": "#/$defs/action"
        },
        "code": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[A-Z][A-Z0-9_]*(-[A-Z0-9]+)*$",
          "$comment": "null = khung vừa dựng, chưa gán mã (SC-FAIL-3 cảnh báo)"
        },
        "level": {
          "enum": [
            "block",
            "warn",
            "info"
          ]
        },
        "when": {
          "type": "string",
          "minLength": 3,
          "maxLength": 200,
          "$comment": "tình huống, viết cho BA / tester đọc"
        },
        "target": {
          "$ref": "#/$defs/target"
        },
        "catchAt": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "ui",
              "module",
              "intake",
              "kernel",
              "db",
              "ngoai"
            ]
          }
        },
        "hint": {
          "type": "string",
          "minLength": 3,
          "maxLength": 200,
          "$comment": "lời nhắc tiếng Việt cho người dùng: sai gì, làm gì tiếp (tooltip)"
        },
        "remedy": {
          "type": "string",
          "$comment": "mã màn sửa (SCREENS) hoặc mã phương án"
        },
        "basis": {
          "type": "string",
          "$comment": "luật / căn cứ (R-*, văn bản)"
        },
        "test": {
          "type": [
            "string",
            "null"
          ],
          "$comment": "<tệp test>[#<chuỗi phải có trong tệp>]; bỏ trống = tìm mã trong tệp"
        },
        "approvedBy": {
          "enum": [
            "ke-toan-truong",
            "ke-toan-thue",
            "ke-toan-noi-bo",
            "ba",
            "chu-don-vi"
          ],
          "$comment": "vai đã duyệt mức chặn / cảnh báo của dòng có ý nghĩa kế toán"
        }
      }
    },
    "target": {
      "type": "object",
      "required": [
        "kind"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "field",
            "selector",
            "origin",
            "flow",
            "state"
          ]
        },
        "path": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*(\\.(\\*|[0-9]+|[A-Za-z_][A-Za-z0-9_]*))*$",
          "$comment": "toạ độ trong chứng từ: a.b, lines.*.itemId"
        },
        "catalog": {
          "type": "string",
          "$comment": "selector: danh mục (item, partner, branch, warehouse, account, …)"
        },
        "allow": {
          "type": "string",
          "$comment": "selector: giá trị được nhận (active, cung-chi-nhanh, …)"
        },
        "inlineFix": {
          "type": "string",
          "$comment": "selector: action thêm / sửa ngay tại chỗ (vd core.item.create)"
        },
        "source": {
          "type": "string",
          "$comment": "origin: nguồn dữ liệu gốc / giới hạn (hop-dong-mua, phan-tich-mua, ton-min-max, han-muc-cong-no, …)"
        },
        "step": {
          "type": "string",
          "$comment": "flow: bước của luồng bị thiếu / sai thứ tự"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "enum": [
                  "field",
                  "selector"
                ]
              }
            }
          },
          "then": {
            "required": [
              "path"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "selector"
              }
            }
          },
          "then": {
            "required": [
              "catalog"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "origin"
              }
            }
          },
          "then": {
            "required": [
              "source"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "flow"
              }
            }
          },
          "then": {
            "required": [
              "step"
            ]
          }
        }
      ]
    }
  }
}
