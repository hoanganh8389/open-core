{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bizcity.vn/schema/feedback/reverse-questions.schema.json",
  "$comment": "[2026-11-25 06:12 PM Johnny Chu - Chu Hoàng Anh] STD-11 — bizcity_reverse_questions@1: ngân hàng câu hỏi ngược theo luồng nghiệp vụ (BIZCITY-FEEDBACK-LOOP-v1.md §2). Dev / AI phải trả lời trước khi viết mã lưu.",
  "title": "bizcity_reverse_questions@1",
  "type": "object",
  "required": ["schema", "version", "flows", "questions"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "bizcity_reverse_questions@1" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(-draft)?$" },
    "$comment": { "type": "string" },
    "flows": {
      "type": "object",
      "$comment": "khoá luồng → tên tiếng Việt; luồng 'chung' áp cho mọi màn"
    },
    "questions": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "flow", "kind", "ask", "why"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^Q-[A-Z]+-[0-9]{2}$" },
          "flow": { "type": "string", "pattern": "^[a-z][a-z-]*$" },
          "kind": { "enum": ["field", "selector", "origin", "flow", "state"] },
          "ask": { "type": "string", "minLength": 10, "maxLength": 240 },
          "why": { "type": "string", "minLength": 10, "maxLength": 240 },
          "codes": { "type": "array", "items": { "type": "string" }, "$comment": "mã hay gặp (gợi ý, không bắt buộc có ở mọi repo)" }
        }
      }
    }
  }
}
