{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bizcity.vn/schema/spine/knowledge.schema.json",
  "title": "bizcity_knowledge@1-draft — kết quả công cụ tri thức chỉ đọc cho Twin Brain",
  "$comment": "[2026-11-24 08:10 PM Johnny Chu - Chu Hoàng Anh] SPINE-4 — data của một công cụ MCP _knowledge_ (BIZCITY-KNOWLEDGE-v1.md §3): as_of bắt buộc, pii_masked phải true, mọi nguồn dẫn bằng ID trục.",
  "$defs": {
    "ulid": { "type": "string", "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$" },
    "doc_ref": { "type": "string", "pattern": "^[a-z][a-z0-9_-]*(\\.[a-z][a-z0-9_-]*)*:[A-Za-z0-9_.-]{1,64}$" },
    "Source": {
      "type": "object",
      "required": ["kind"],
      "additionalProperties": false,
      "properties": {
        "kind": { "enum": ["item", "partner", "contact", "branch", "document", "tenant"] },
        "id": { "type": "string", "maxLength": 64 },
        "code": { "type": "string", "maxLength": 64 },
        "doc_ref": { "$ref": "#/$defs/doc_ref" }
      },
      "anyOf": [ { "required": ["id"] }, { "required": ["code"] }, { "required": ["doc_ref"] } ]
    },
    "KnowledgeData": {
      "type": "object",
      "required": ["as_of", "rows", "sources", "pii_masked"],
      "additionalProperties": false,
      "properties": {
        "as_of": { "type": "string", "minLength": 10 },
        "rows": { "type": "array", "maxItems": 200, "items": { "type": "object" } },
        "sources": { "type": "array", "items": { "$ref": "#/$defs/Source" } },
        "pii_masked": { "const": true },
        "cursor": { "type": "string", "maxLength": 200 },
        "note": { "type": "string", "maxLength": 500 }
      }
    },
    "ToolDescriptorKnowledge": {
      "type": "object",
      "required": ["name", "title", "description", "inputSchema", "outputSchema", "annotations"],
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z][a-z0-9]*_knowledge_[a-z][a-z0-9_]*$" },
        "title": { "type": "string" },
        "description": { "type": "string", "minLength": 10 },
        "inputSchema": { "type": "object" },
        "outputSchema": { "type": "object" },
        "annotations": {
          "type": "object",
          "required": ["readOnlyHint", "destructiveHint", "idempotentHint"],
          "properties": {
            "readOnlyHint": { "const": true },
            "destructiveHint": { "const": false },
            "idempotentHint": { "const": true },
            "openWorldHint": { "type": "boolean" }
          }
        }
      }
    }
  }
}
