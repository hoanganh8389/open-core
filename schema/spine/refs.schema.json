{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bizcity.vn/schema/spine/refs.schema.json",
  "title": "bizcity_spine@1-draft — định danh và hình thức tham chiếu trên dây",
  "$comment": "[2026-11-24 05:08 PM Johnny Chu - Chu Hoàng Anh] SPINE-1 — tám trục (BIZCITY-SPINE-v1.md §2) và bốn hình thức *Ref (§3). Máy đọc cho mọi ngôn ngữ.",
  "$defs": {
    "ulid": { "type": "string", "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$" },
    "tenant": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,30}$" },
    "sub": { "type": "string", "pattern": "^(wp:[0-9]+|biz:[A-Za-z0-9_-]{1,64})$" },
    "item_id": { "$ref": "#/$defs/ulid" },
    "contact_id": { "$ref": "#/$defs/ulid" },
    "uom": { "type": "string", "pattern": "^[A-Za-z0-9_.-]{1,20}$" },
    "branch_code": { "type": "string", "pattern": "^[A-Z0-9_.-]{1,20}$" },
    "partner_code": { "type": "string", "pattern": "^[A-Za-z0-9_.-]{1,40}$" },
    "doc_ref": { "type": "string", "pattern": "^[a-z][a-z0-9_-]*(\\.[a-z][a-z0-9_-]*)*:[A-Za-z0-9_.-]{1,64}$" },
    "date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "local_key": { "type": "string", "pattern": "^[a-z][a-z0-9-]*:[a-z][a-z0-9_-]*:[A-Za-z0-9_.-]{1,64}$" },
    "identity": {
      "type": "object",
      "required": ["kind", "value"],
      "additionalProperties": false,
      "properties": {
        "kind": { "enum": ["phone", "email", "tax_code", "zalo_uid", "fb_psid", "fb_uid", "bank_account"] },
        "value": { "type": "string", "minLength": 1, "maxLength": 200 },
        "scope": { "type": "string", "maxLength": 100 },
        "proof": { "type": "string", "maxLength": 100 }
      }
    },
    "refBase": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 64 },
        "code": { "type": "string", "minLength": 1, "maxLength": 64 },
        "as_of": { "$ref": "#/$defs/date" },
        "identity": { "$ref": "#/$defs/identity" },
        "local": { "$ref": "#/$defs/local_key" }
      },
      "anyOf": [
        { "required": ["id"] },
        { "required": ["code"] },
        { "required": ["identity"] },
        { "required": ["local"] }
      ]
    },
    "ItemRef": {
      "allOf": [
        { "$ref": "#/$defs/refBase" },
        { "properties": { "id": { "$ref": "#/$defs/item_id" }, "code": { "type": "string", "pattern": "^[A-Za-z0-9_.\\-/]{1,64}$" } }, "not": { "required": ["identity"] } }
      ]
    },
    "PartnerRef": {
      "allOf": [
        { "$ref": "#/$defs/refBase" },
        { "properties": { "code": { "$ref": "#/$defs/partner_code" } }, "not": { "required": ["id"] } }
      ],
      "$comment": "partner_id bigint là nội bộ open-ketoan, không lộ ra dây: ngoài chỉ gửi code (R-MD-2)."
    },
    "ContactRef": {
      "allOf": [
        { "$ref": "#/$defs/refBase" },
        { "properties": { "id": { "$ref": "#/$defs/contact_id" } }, "not": { "required": ["code"] } }
      ]
    },
    "BranchRef": {
      "type": "object",
      "required": ["code"],
      "additionalProperties": false,
      "properties": { "code": { "$ref": "#/$defs/branch_code" }, "as_of": { "$ref": "#/$defs/date" } }
    },
    "UomRef": {
      "type": "object",
      "required": ["uom"],
      "additionalProperties": false,
      "properties": { "uom": { "$ref": "#/$defs/uom" } },
      "$comment": "Dòng chứng từ gửi uom + qty, không gửi ratio (chủ giữ)."
    },
    "DocLink": {
      "type": "object",
      "required": ["from", "to", "role"],
      "additionalProperties": false,
      "properties": {
        "from": { "$ref": "#/$defs/doc_ref" },
        "to": { "$ref": "#/$defs/doc_ref" },
        "role": { "enum": ["source", "reverses", "replaces", "settles", "attachesTo", "ledger"] }
      }
    },
    "Envelope": {
      "type": "object",
      "required": ["tenant"],
      "properties": {
        "tenant": { "$ref": "#/$defs/tenant" },
        "actor": { "type": "object", "properties": { "sub": { "$ref": "#/$defs/sub" } } }
      }
    }
  }
}
